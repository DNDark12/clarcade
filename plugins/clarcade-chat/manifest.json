{
  "manifest_version": "0.3",
  "name": "clarcade-chat",
  "display_name": "Clarcade",
  "version": "0.1.2",
  "description": "Play Caro (Gomoku) on your LAN inside a Claude Desktop chat. Join rooms hosted with Clarcade in Claude Code.",
  "author": { "name": "DNDark" },
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "server/server.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/server.mjs"]
    }
  },
  "compatibility": {
    "platforms": ["darwin"],
    "runtimes": { "node": ">=22.0.0" }
  }
}
